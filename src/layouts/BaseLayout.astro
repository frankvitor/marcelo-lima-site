---
import '../styles/global.css';
import { site } from '../config/site';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Caminho da imagem OG dentro de /public. */
  imagem?: string;
  /** Objeto(s) JSON-LD a embutir na página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = `${site.nome} · ${site.descritor}`,
  description = site.descricao,
  noindex = false,
  imagem = '/og.png',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const urlImagem = new URL(imagem, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2F313D" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={urlImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nome} — ${site.descritor}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImagem} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Analytics />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ardosia focus:px-5 focus:py-3 focus:text-branco"
    >
      Pular para o conteúdo
    </a>
    <slot />
    <script>
      // Revela elementos .reveal ao entrar na tela (fade/slide sutil). Sem JS, tudo fica visível.
      const alvos = document.querySelectorAll<HTMLElement>('.reveal');
      const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduzir || !('IntersectionObserver' in window)) {
        alvos.forEach((el) => el.classList.add('visivel'));
      } else {
        const io = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('visivel');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        alvos.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
