---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFlutuante from '../components/WhatsappFlutuante.astro';
import Hero from '../components/secoes/Hero.astro';
import Jornadas from '../components/secoes/Jornadas.astro';
import ComoFunciona from '../components/secoes/ComoFunciona.astro';
import Riscos from '../components/secoes/Riscos.astro';
import SimuladorSecao from '../components/secoes/SimuladorSecao.astro';
import Cases from '../components/secoes/Cases.astro';
import Atendimento from '../components/secoes/Atendimento.astro';
import Sobre from '../components/secoes/Sobre.astro';
import Depoimentos from '../components/secoes/Depoimentos.astro';
import Faq from '../components/secoes/Faq.astro';
import CtaFinal from '../components/secoes/CtaFinal.astro';
import { professionalService } from '../lib/jsonld';
import Quiz from '../components/islands/Quiz';
---

<BaseLayout jsonLd={professionalService(Astro.site!.href)}>
  <Header />
  <main id="conteudo">
    <Hero />
    <Jornadas />
    <ComoFunciona />
    <Riscos />
    <SimuladorSecao />
    <Cases />
    <Atendimento />
    <Sobre />
    <Depoimentos />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <WhatsappFlutuante />
  <Quiz client:idle />
</BaseLayout>
