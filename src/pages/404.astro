---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Página não encontrada · Marcelo Lima" noindex>
  <Header />
  <main id="conteudo" class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center gap-6 px-5 py-20 text-center">
    <span class="grid size-20 place-items-center rounded-full bg-vinho-50"><Icon nome="chave" class="size-10" /></span>
    <p class="font-titulo text-6xl font-bold text-marinho-900 sm:text-8xl" aria-hidden="true">404</p>
    <h1 class="text-3xl sm:text-4xl">Esta página não foi encontrada</h1>
    <p class="max-w-md text-cinza">
      O endereço pode ter mudado ou não existir. Volte ao início e continue de onde parou.
    </p>
    <Button href="/">Voltar ao início <Icon nome="seta" class="size-4" /></Button>
  </main>
  <Footer />
</BaseLayout>
