---
import Icon from './Icon.astro';
import { linkWhatsapp } from '../lib/whatsapp';

const href = linkWhatsapp('Olá, Marcelo! Vim pelo site e gostaria de conversar sobre leilão de imóveis.');
---

<a
  href={href}
  data-whatsapp
  aria-label="Falar com o Marcelo no WhatsApp"
  class="fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-vinho text-branco shadow-card transition-transform hover:scale-105"
>
  <Icon nome="mensagem" class="size-7" />
</a>
