---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { nav } from '../data/home';
import { linkWhatsapp } from '../lib/whatsapp';

interface Props {
  /** Home: header transparente sobre o hero, que fica sólido ao rolar. Outras páginas: sempre sólido. */
  sobreHero?: boolean;
}
const { sobreHero } = Astro.props;
const ehHome = sobreHero ?? Astro.url.pathname === '/';
const base = Astro.url.pathname === '/' ? '' : '/';
const whats = linkWhatsapp('Olá, Marcelo! Vim pelo site e gostaria de conversar sobre leilão de imóveis.');
---

<header
  class={`${ehHome ? 'fixed' : 'sticky'} inset-x-0 top-0 z-40 border-b transition-colors duration-300 data-[solido=true]:border-white/10 data-[solido=true]:bg-marinho-900/95 data-[solido=true]:backdrop-blur ${
    ehHome ? 'border-transparent' : 'border-white/10 bg-marinho-900'
  }`}
  data-header
  data-solido={ehHome ? 'false' : 'true'}
  data-home={ehHome ? 'true' : 'false'}
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:h-20">
    <a href={`${base}#inicio`}><Logo variante="negativa" class="h-9 w-auto sm:h-11" /></a>

    <nav aria-label="Principal" class="hidden items-center gap-8 lg:flex">
      {
        nav.map((i) => (
          <a href={base + i.href} class="text-[0.95rem] text-branco/90 transition-colors hover:text-rosa">
            {i.rotulo}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <Button href={whats} class="max-sm:hidden !px-5 !py-2.5" data-whatsapp>
        <Icon nome="mensagem" class="size-4" /> Falar no WhatsApp
      </Button>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-xl border border-white/25 text-branco lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
        data-menu-botao
      >
        <Icon nome="menu" class="size-5" />
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Menu mobile" class="hidden border-t border-white/10 bg-marinho-900 lg:hidden" data-menu>
    <ul class="mx-auto flex max-w-7xl flex-col px-5 py-3">
      {
        nav.map((i) => (
          <li>
            <a href={base + i.href} class="block py-3 font-medium text-branco">
              {i.rotulo}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <Button href={whats} class="w-full" data-whatsapp>
          <Icon nome="mensagem" class="size-4" /> Falar no WhatsApp
        </Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const botao = document.querySelector<HTMLButtonElement>('[data-menu-botao]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  // Sólido ao rolar (ou com o menu mobile aberto); transparente no topo da home.
  const atualizar = () => {
    if (!header || header.dataset.home !== 'true') return;
    const aberto = botao?.getAttribute('aria-expanded') === 'true';
    header.dataset.solido = String(window.scrollY > 24 || aberto);
  };
  const alternar = (abrir: boolean) => {
    botao?.setAttribute('aria-expanded', String(abrir));
    botao?.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
    menu?.classList.toggle('hidden', !abrir);
    atualizar();
  };
  atualizar();
  window.addEventListener('scroll', atualizar, { passive: true });
  botao?.addEventListener('click', () => alternar(botao.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => alternar(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') alternar(false);
  });
</script>
