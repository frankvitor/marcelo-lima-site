---
interface Props {
  titulo: string;
  nivel?: 'h1' | 'h2';
  claro?: boolean;
}
const { titulo, nivel: Tag = 'h2', claro = false } = Astro.props;
---

<Tag
  class={`titulo-display inline-block rounded-[var(--radius-moldura)] border-[1.5px] px-6 py-3 text-3xl sm:text-4xl ${
    claro ? 'border-branco/70 text-branco' : 'border-vinho-700 text-vinho-700'
  }`}
>
  {titulo}
</Tag>
