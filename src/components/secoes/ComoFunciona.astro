---
import TituloMoldura from '../TituloMoldura.astro';
import { comoFunciona } from '../../data/home';
---

<section id="como-funciona" class="scroll-mt-24 bg-claro py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal mb-12 flex flex-col gap-4">
      <TituloMoldura titulo={comoFunciona.titulo} />
      <p class="max-w-2xl text-cinza">{comoFunciona.intro}</p>
    </div>
    <ol class="grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-5">
      {
        comoFunciona.etapas.map((e, i) => (
          <li class="reveal relative flex flex-col gap-3 border-t-2 border-ardosia pt-5" style={`transition-delay:${i * 70}ms`}>
            <span class="font-titulo text-5xl font-bold leading-none text-laranja" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-lg leading-tight text-ardosia">
              <span class="sr-only">Etapa {i + 1}: </span>
              {e.titulo}
            </h3>
            <p class="text-sm text-cinza">{e.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
