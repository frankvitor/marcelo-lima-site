---
import TituloMoldura from '../TituloMoldura.astro';
import Icon from '../Icon.astro';
import MapaBrasil from '../MapaBrasil.astro';
import { atendimento } from '../../data/home';
---

<section id="atendimento" class="scroll-mt-24 bg-claro py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2">
    <div class="reveal flex flex-col items-start gap-5">
      <TituloMoldura titulo={atendimento.titulo} />
      <p class="text-lg text-cinza">{atendimento.texto}</p>
      <ul class="flex flex-col gap-3">
        {
          atendimento.pontos.map((p) => (
            <li class="flex items-center gap-3 font-medium text-ardosia">
              <span class="grid size-7 place-items-center rounded-full bg-laranja text-preto">
                <Icon nome="check" class="size-4" />
              </span>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reveal"><MapaBrasil /></div>
  </div>
</section>
