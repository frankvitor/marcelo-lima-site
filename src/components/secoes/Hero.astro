---
import Button from '../Button.astro';
import Pill from '../Pill.astro';
import Icon from '../Icon.astro';
import FotoDuotone from '../FotoDuotone.astro';
import { hero } from '../../data/home';
import { linkWhatsapp } from '../../lib/whatsapp';
import predio from '../../assets/img/predio-placeholder.svg';

const whats = linkWhatsapp('Olá, Marcelo! Vim pelo site e gostaria de conversar sobre leilão de imóveis.');
---

<section id="inicio" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:py-24">
    <div class="flex flex-col items-start gap-6">
      <Pill><Icon nome="pin" class="size-4" />{hero.selo}</Pill>
      <h1 class="titulo-display text-[2.1rem] leading-[1.02] text-ardosia sm:text-5xl lg:text-[3.4rem]">
        {hero.titulo}
      </h1>
      <p class="max-w-xl text-lg text-cinza">{hero.subtitulo}</p>
      <div class="flex flex-wrap gap-3">
        <Button data-quiz>{hero.ctaPrincipal} <Icon nome="seta" class="size-4" /></Button>
        <Button href={whats} variante="contorno" data-whatsapp>
          <Icon nome="mensagem" class="size-4" />{hero.ctaSecundario}
        </Button>
      </div>
    </div>

    <div class="relative">
      <div class="absolute -right-3 -top-3 hidden h-full w-full rounded-card border-[1.5px] border-ardosia/40 sm:block" aria-hidden="true"></div>
      <FotoDuotone src={predio.src} alt={hero.fotoAlt} class="relative aspect-[4/5] rounded-card shadow-card sm:aspect-[5/6]" />
      <div class="absolute -bottom-5 left-5 flex items-center gap-3 rounded-card bg-branco px-5 py-4 shadow-card">
        <Icon nome="chave" class="size-8 text-ardosia" />
        <p class="font-titulo text-sm font-semibold leading-tight text-ardosia">
          Do edital<br />às chaves
        </p>
      </div>
    </div>
  </div>
</section>
