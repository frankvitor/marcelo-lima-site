---
import { getCollection } from 'astro:content';
import TituloMoldura from '../TituloMoldura.astro';
import Icon from '../Icon.astro';
import { faq as textos } from '../../data/home';

const perguntas = (await getCollection('faq')).sort((a, b) => a.data.ordem - b.data.ordem);
---

<section id="duvidas" class="scroll-mt-24 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-5">
    <div class="reveal mb-10"><TituloMoldura titulo={textos.titulo} /></div>
    <div class="flex flex-col gap-3">
      {
        perguntas.map(({ data: p }) => (
          <details class="group reveal rounded-[var(--radius-moldura)] border border-linha bg-branco open:shadow-card">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-titulo font-semibold text-marinho-900 [&::-webkit-details-marker]:hidden">
              {p.pergunta}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-vinho-50 transition-transform group-open:rotate-45">
                <Icon nome="mais" class="size-4" />
              </span>
            </summary>
            <p class="px-5 pb-5 text-cinza">{p.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
