---
import Icon from '../Icon.astro';
import TituloMoldura from '../TituloMoldura.astro';
import ArcoDivisor from '../ArcoDivisor.astro';
import { riscos } from '../../data/home';
---

<section class="bg-ardosia pt-16 text-branco sm:pt-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal mb-10 flex flex-col gap-4">
      <TituloMoldura titulo={riscos.titulo} claro />
      <p class="max-w-2xl text-prata">{riscos.intro}</p>
    </div>
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        riscos.itens.map((r, i) => (
          <li class="reveal flex gap-4 rounded-card bg-branco p-6 text-ardosia shadow-card" style={`transition-delay:${i * 60}ms`}>
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ambar">
              <Icon nome={r.icone} class="size-6" />
            </span>
            <div>
              <h3 class="mb-1 text-lg leading-tight">{r.titulo}</h3>
              <p class="text-sm text-cinza">{r.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="mt-12 sm:mt-16"><ArcoDivisor cor="var(--color-gelo)" /></div>
</section>
