---
import { getCollection } from 'astro:content';
import TituloMoldura from '../TituloMoldura.astro';
import Pill from '../Pill.astro';
import FichaTecnica from '../FichaTecnica.astro';
import { cases as textos } from '../../data/home';

const lista = (await getCollection('cases')).sort((a, b) => a.data.ordem - b.data.ordem);
---

{
  lista.length > 0 && (
    <section id="cases" class="scroll-mt-24 bg-claro py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mb-10 flex flex-col gap-4">
          <TituloMoldura titulo={textos.titulo} />
          <p class="max-w-2xl text-cinza">{textos.intro}</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {lista.map(({ data: c }) => (
            <article class="reveal flex flex-col gap-2 rounded-card bg-branco p-6 shadow-card">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 class="text-lg text-marinho-900">{c.tipo}</h3>
                  <p class="text-sm text-cinza">
                    {c.cidade}/{c.uf}
                  </p>
                </div>
                <Pill>Desconto real: {c.descontoReal}</Pill>
              </div>
              <FichaTecnica
                layout="linha"
                itens={[
                  { icone: 'casa', valor: c.avaliacao, rotulo: 'Avaliação' },
                  { icone: 'dinheiro', valor: c.arrematado, rotulo: 'Arrematado' },
                  { icone: 'percentual', valor: c.custoTotal, rotulo: 'Custo total' },
                ]}
              />
              <div class="flex items-center justify-between gap-2 border-t border-linha pt-3 text-sm">
                <span class="text-cinza">Prazo até as chaves</span>
                <strong class="font-titulo text-marinho-900">{c.prazo}</strong>
              </div>
              {c.exemplo && <p class="mt-1 text-xs font-medium text-cinza">{textos.avisoExemplo}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
